# 1. Move to Node 22 to satisfy @darraghor/eslint-plugin-nestjs-typed
FROM node:22-alpine

# 2. Install build dependencies for native modules
RUN apk add --no-cache python3 make g++ 

WORKDIR /app

# 3. Copy package files
COPY package*.json ./

# 4. FIX: Use --ignore-scripts to skip Husky/Git hooks during Docker build
# Use --legacy-peer-deps for NestJS 11 compatibility
RUN npm install --ignore-scripts --legacy-peer-deps

# 5. Copy the rest of the source code (now .githooks etc are here)
COPY . .

# 6. Generate the documentation
RUN npx @compodoc/compodoc -p tsconfig.json

# 7. Install a tiny web server
RUN npm install -g http-server

EXPOSE 8080

CMD ["http-server", "documentation", "-p", "8080"]